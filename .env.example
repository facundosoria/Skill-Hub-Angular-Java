# Copiar a .env en cada host. Solo credenciales; nunca commitear el .env real.
# El destino y la URL publica se eligen con ./scripts/rebuild-app.sh local|raspi|prod.

POSTGRES_USER=skillhub
POSTGRES_PASSWORD=cambiar-esto-por-una-password-generada
POSTGRES_DB=skillhub

# Secreto de la cookie de sesion (HS256). >= 32 chars.
# En el swap se reusa el del stack Next.js para no desloguear a nadie.
# Generar uno nuevo con: openssl rand -base64 32
SESSION_SECRET=cambiar-esto-por-un-secreto-de-32-bytes-como-minimo

# Ory Hydra (OAuth 2.1 para /api/mcp, ver plan de OAuth). Generar con:
# HYDRA_DB_PASSWORD: openssl rand -hex 24 (hex evita caracteres reservados en DSN)
# HYDRA_SYSTEM_SECRET: openssl rand -hex 32
HYDRA_DB_PASSWORD=cambiar-esto-por-una-password-generada
HYDRA_SYSTEM_SECRET=cambiar-esto-por-un-secreto-de-32-bytes-como-minimo

# --- Infra monitoring (app.infra, ver docs/infra-monitor.md) ----------------
# Apagado por defecto: con esto vacio el stack arranca y sirve igual que antes.
INFRA_ENABLED=false
# Registry de Eureka. En la tailnet va por el FQDN del nodo de la plataforma.
INFRA_EUREKA_URL=
INFRA_INTERVAL=30s
INFRA_CONNECT_TIMEOUT=2s
INFRA_READ_TIMEOUT=3s
INFRA_MAX_CONCURRENCY=4
INFRA_FAILURE_THRESHOLD=3
INFRA_RECOVERY_THRESHOLD=2
INFRA_DEGRADE_LATENCY=1500ms
INFRA_STALE_GRACE=90s
INFRA_RETENTION_DAYS=90
INFRA_WINDOW_24H=24h
INFRA_WINDOW_7D=7d
# Allowlist obligatoria: sin hosts/puertos aca no se sondea ningun destino.
# Para micros fuera de las redes Docker: la IP o el nombre del nodo en la tailnet.
INFRA_ALLOWED_HOSTS=
INFRA_ALLOWED_PORTS=8081,8082,8083,8084,8085,8086,8087,8088,8090,8761

# --- Conectividad Tailscale (solo con docker-compose.tailscale.yml) ---------
# Key reusable y NO efimera con tag:infra-monitor (ver docs/infra-monitor-tailnet.md).
# Nunca al repo: vive solo en el .env del host.
TS_AUTHKEY=
TS_HOSTNAME=skillhub-infra-monitor
# Opcional: listado de nodos front por la API de la tailnet (pendiente, apagado).
INFRA_TAILSCALE_ENABLED=false
INFRA_TAILSCALE_TAILNET=
INFRA_TAILSCALE_API_KEY=
