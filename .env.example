# Copiar a .env en el server. NO commitear el .env real.

POSTGRES_USER=skillhub
POSTGRES_PASSWORD=skillhub
POSTGRES_DB=skillhub

# Secreto de la cookie de sesion (HS256). >= 32 chars.
# En el swap se reusa el del stack Next.js para no desloguear a nadie.
# Generar uno nuevo con: openssl rand -base64 32
SESSION_SECRET=cambiar-esto-por-un-secreto-de-32-bytes-como-minimo

APP_TZ=America/Argentina/Cordoba
USAGE_RETENTION_DAYS=90

# Ory Hydra (OAuth 2.1 para /api/mcp, ver plan de OAuth). Generar con:
# HYDRA_DB_PASSWORD: openssl rand -hex 24
# HYDRA_SYSTEM_SECRET: openssl rand -hex 32
HYDRA_DB_PASSWORD=cambiar-esto-por-una-password-generada
HYDRA_SYSTEM_SECRET=cambiar-esto-por-un-secreto-de-32-bytes-como-minimo

# URL publica por la que se llega a este stack. En produccion es el dominio
# real; para probar todo en tu maquina ANTES de subirlo al server, comentá la
# linea de prod y usa la de local (tiene que matchear el puerto publicado por
# el servicio "web", 8087 por defecto).
PUBLIC_BASE_URL=https://marketplace-utn.tech
# PUBLIC_BASE_URL=http://localhost:8087
