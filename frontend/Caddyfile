# Sirve el SPA Angular y proxea /api al backend Spring Boot.
# El TLS y el dominio los pone el nginx del host; aca solo HTTP en :8080.
:8080 {
	encode gzip

	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Angular activa su stylesheet optimizado con este handler inline. El hash
		# permite solamente ese handler, sin habilitar scripts inline arbitrarios.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-hashes' 'sha256-MhtPZXr7+LpJUY5qtMutB+qWfQtMaPccfe7QXtCcEYc='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'"
		-Server
	}

	# API -> backend. handle {} garantiza exclusion mutua con el bloque del SPA.
	handle /api/* {
		reverse_proxy backend:8080
	}
	handle /.well-known/oauth-protected-resource {
		reverse_proxy backend:8080
	}

	# Superficie PUBLICA de Hydra (OAuth 2.1 para /api/mcp, ver plan de OAuth).
	# El puerto admin (4445) nunca se proxea desde aca ni desde ningun lado.
	handle /oauth2/* {
		reverse_proxy hydra:4444
	}
	handle /.well-known/oauth-authorization-server {
		# Hydra v2 no expone este path (solo openid-configuration, RFC 8414 vs
		# OIDC discovery) - lo sirve el backend, que reenvia el contenido real.
		reverse_proxy backend:8080
	}
	handle /.well-known/openid-configuration {
		reverse_proxy hydra:4444
	}
	handle /.well-known/jwks.json {
		reverse_proxy hydra:4444
	}
	handle /userinfo {
		reverse_proxy hydra:4444
	}

	# Resto -> archivos estaticos, con fallback a index.html (rutas del router).
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
